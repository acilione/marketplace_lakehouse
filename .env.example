# Development-only credentials. Copy to .env; never reuse outside the local profile.
DEV_MINIO_ROOT_USER=marketplace_local
DEV_MINIO_ROOT_PASSWORD=change-me-local-minio-password
DEV_POSTGRES_USER=marketplace_local
DEV_POSTGRES_PASSWORD=change-me-local-postgres-password
DEV_AIRFLOW_ADMIN=admin
DEV_AIRFLOW_PASSWORD=change-me-local-airflow-password
DEV_GRAFANA_ADMIN=admin
DEV_GRAFANA_PASSWORD=change-me-local-grafana-password
MLH_MINIO_API_PORT=19000
MLH_MINIO_CONSOLE_PORT=19001
MLH_ARCHITECTURE_PORT=4173
DEV_DASHBOARD_OPERATOR_PASSWORD=change-me-local-operator-password
DEV_DASHBOARD_VIEWER_PASSWORD=change-me-local-viewer-password
# Set true behind an HTTPS reverse proxy; HTTP loopback development requires false.
AUTH_SECURE_COOKIE=false
