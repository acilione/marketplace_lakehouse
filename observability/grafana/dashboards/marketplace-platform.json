{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(up{job=~\"spark.*\"}) by (job)", "legendFormat": "{{job}}"}],
      "title": "Spark services available",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "marketplace_pipeline_duration_seconds", "legendFormat": "{{pipeline}}"}],
      "title": "Last pipeline run duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "time() - (marketplace_pipeline_last_event_seconds{pipeline=\"bronze_event_ingest\"} > 0)", "legendFormat": "{{pipeline}}"}],
      "title": "Age of newest source event in Bronze",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "(marketplace_pipeline_last_quality_failure_seconds > bool (time() - 3600)) * (marketplace_pipeline_last_quality_failure_seconds > bool 0)", "legendFormat": "{{pipeline}}"}],
      "title": "Quality failure in the last hour (0/1)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 42,
  "tags": ["marketplace", "spark", "iceberg"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Marketplace Platform",
  "uid": "marketplace-platform",
  "version": 2
}

